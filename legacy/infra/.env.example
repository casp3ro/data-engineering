# Car Price Pipeline — environment variables
# Copy to .env at the repo root and fill in your values.
# NEVER commit .env to git.

# ── Databricks (car_price_pipeline DAG) ───────────────────────────────
DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
DATABRICKS_JOB_ID=123456

# ── Kafka ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=car-listings

# ── Airflow (required for docker compose) ─────────────────────────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=<generated>
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=<generated>

# ── MinIO (local profile) ─────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_S3_ENDPOINT=http://localhost:9000

# ── Spark (host: local[*], Docker Airflow: spark://spark-master:7077) ─
SPARK_MASTER_URL=local[*]

# ── dbt / DuckDB ──────────────────────────────────────────────────────
WAREHOUSE_PATH=data/warehouse.duckdb
PIPELINE_MODE=local
DBT_TARGET=local

# ── Dataset ───────────────────────────────────────────────────────────
CAR_PRICE_CSV_PATH=data/raw/vehicles.csv
