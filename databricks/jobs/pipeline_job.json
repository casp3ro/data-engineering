{
  "name": "car-price-pipeline",
  "max_concurrent_runs": 1,
  "job_clusters": [
    {
      "job_cluster_key": "main",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 0,
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*]"
        },
        "custom_tags": {
          "ResourceClass": "SingleNode"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze_ingest",
      "job_cluster_key": "main",
      "notebook_task": {
        "notebook_path": "/Repos/car-price-pipeline/databricks/notebooks/01_bronze_ingest",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "silver_transform",
      "depends_on": [{"task_key": "bronze_ingest"}],
      "job_cluster_key": "main",
      "notebook_task": {
        "notebook_path": "/Repos/car-price-pipeline/databricks/notebooks/02_silver_transform",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "gold_aggregate",
      "depends_on": [{"task_key": "silver_transform"}],
      "job_cluster_key": "main",
      "notebook_task": {
        "notebook_path": "/Repos/car-price-pipeline/databricks/notebooks/03_gold_aggregate",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1800
    }
  ]
}
