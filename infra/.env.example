# Car Price Pipeline — environment variables
# Copy to .env at the repo root and fill in your values.
# NEVER commit .env to git.

# ── Databricks ────────────────────────────────────────────────────────
DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
# Databricks Job ID (set after registering pipeline_job.json via CLI)
DATABRICKS_JOB_ID=123456

# ── Kafka ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=car-listings
SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Airflow ───────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=<generated>
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=<generated>

# ── dbt / DuckDB ──────────────────────────────────────────────────────
WAREHOUSE_PATH=/opt/airflow/data/warehouse.duckdb

# ── Dataset ───────────────────────────────────────────────────────────
# Download from: https://www.kaggle.com/datasets/austinreese/craigslist-carstrucks-data
CAR_PRICE_CSV_PATH=/opt/airflow/data/raw/vehicles.csv
